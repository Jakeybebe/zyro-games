@echo off
set "ZYRO_BAT=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "iex ((Get-Content -LiteralPath '%~f0' -Raw) -split ('#PS_'+'START'))[1]"
exit /b
#PS_START
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$script:page = 'home'
$script:hover = ''
$script:dragging = $false
$script:dragStart = $null
$script:theme = 'blue'
$script:t = 0.0

# --- saved theme ---
$script:cfgDir = Join-Path $env:APPDATA 'ZyroGames'
$script:cfgFile = Join-Path $script:cfgDir 'theme.txt'
try {
    if (Test-Path -LiteralPath $script:cfgFile) {
        $saved = (Get-Content -LiteralPath $script:cfgFile -Raw).Trim()
        if ($saved -eq 'blue' -or $saved -eq 'black') { $script:theme = $saved }
    }
} catch {}

function SaveTheme {
    try {
        if (-not (Test-Path -LiteralPath $script:cfgDir)) { New-Item -ItemType Directory -Path $script:cfgDir -Force | Out-Null }
        Set-Content -LiteralPath $script:cfgFile -Value $script:theme
    } catch {}
}

# --- Logo icon + desktop shortcut ---
$script:iconFile = Join-Path $script:cfgDir 'zyro.ico'
$script:shortcutFlag = Join-Path $script:cfgDir 'shortcut-made.txt'
$script:shortcutMsg = ''
$script:shortcutMsgUntil = 0.0
$script:iconB64 = ''

function EnsureIcon {
    try {
        if (-not (Test-Path -LiteralPath $script:cfgDir)) { New-Item -ItemType Directory -Path $script:cfgDir -Force | Out-Null }
        $bytes = [Convert]::FromBase64String($script:iconB64)
        $needs = $true
        if (Test-Path -LiteralPath $script:iconFile) {
            if ((Get-Item -LiteralPath $script:iconFile).Length -eq $bytes.Length) { $needs = $false }
        }
        if ($needs) { [System.IO.File]::WriteAllBytes($script:iconFile, $bytes) }
        return $true
    } catch { return $false }
}

function MakeShortcut {
    $bat = $env:ZYRO_BAT
    if ([string]::IsNullOrWhiteSpace($bat)) { return $false }
    if (-not (Test-Path -LiteralPath $bat)) { return $false }
    try {
        [void](EnsureIcon)
        $desktop = [Environment]::GetFolderPath('Desktop')
        $lnk = Join-Path $desktop 'Zyro games.lnk'
        $safe = $bat.Replace("'", "''")
        $cmd = '$env:ZYRO_LNK=''1''; $env:ZYRO_BAT=''' + $safe + '''; iex ((Get-Content -LiteralPath ''' + $safe + ''' -Raw) -split (''#PS_''+''START''))[1]'
        $ws = New-Object -ComObject WScript.Shell
        $s = $ws.CreateShortcut($lnk)
        $s.TargetPath = Join-Path $env:WINDIR 'System32\WindowsPowerShell\v1.0\powershell.exe'
        $s.Arguments = '-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "' + $cmd + '"'
        $s.WorkingDirectory = Split-Path -Parent $bat
        $s.WindowStyle = 7
        $s.IconLocation = $script:iconFile + ',0'
        $s.Description = 'Zyro games'
        $s.Save()
        return $true
    } catch { return $false }
}

# every launch: make sure the desktop shortcut exists (re-creates it if deleted or moved).
# If we were started from the .bat itself, hand over to the shortcut so the launcher
# runs exactly like the shortcut (with the Zyro logo) and then close this copy.
try {
    $lnkPath = Join-Path ([Environment]::GetFolderPath('Desktop')) 'Zyro games.lnk'
    if ($env:ZYRO_LNK -eq '1' -and (Test-Path -LiteralPath $lnkPath)) { $madeLnk = $false } else { $madeLnk = MakeShortcut }
    if ($madeLnk) { Set-Content -LiteralPath $script:shortcutFlag -Value '1' }
    if ($madeLnk -and $env:ZYRO_LNK -ne '1' -and $env:ZYRO_RELAUNCHED -ne '1') {
        $env:ZYRO_RELAUNCHED = '1'
        if (Test-Path -LiteralPath $lnkPath) {
            Start-Process -FilePath $lnkPath
            exit
        }
    }
} catch {}

# --- Library game: "Test" (JS Dash) ---
$script:gameDir = Join-Path $script:cfgDir 'games\test'
$script:installed = (Test-Path -LiteralPath (Join-Path $script:gameDir 'index.html')) -and (Test-Path -LiteralPath (Join-Path $script:gameDir 'script.js'))
$script:dl = -1.0
$script:dlMsg = ''
$script:dlMsgUntil = 0.0

# --- updates (pulls new game files / a new launcher from the update link) ---
$script:updateUrl = 'https://raw.githubusercontent.com/YOUR-USERNAME/YOUR-REPO/main'
$script:baseVersion = '1.0'
$script:buildId = '186c3eb930'
$script:updMsg = ''
$script:updMsgUntil = 0.0
$script:verFile = Join-Path $script:cfgDir 'version.txt'
$script:stampFile = Join-Path $script:gameDir 'build.txt'
function GetVersion {
    try { $v = (Get-Content -LiteralPath $script:verFile -Raw -ErrorAction Stop).Trim(); if ($v) { return $v } } catch {}
    return $script:baseVersion
}
function SetUpd($m) { $script:updMsg = $m; $script:updMsgUntil = $script:t + 12.0; try { $form.Invalidate(); $form.Update() } catch {} }
function DoUpdate {
    $base = $script:updateUrl.Trim().TrimEnd('/')
    if (-not $base -or $base -match 'YOUR-') { SetUpd 'No update link set in the launcher yet.'; return }
    SetUpd 'Checking for updates...'
    $made = @()
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $bust = '?t=' + [DateTime]::UtcNow.Ticks
        $raw = (Invoke-WebRequest -UseBasicParsing -Uri ($base + '/manifest.json' + $bust) -TimeoutSec 20).Content
        if ($raw -is [byte[]]) { $raw = [System.Text.Encoding]::UTF8.GetString($raw) }
        $m = ($raw.TrimStart([char]0xFEFF)) | ConvertFrom-Json
        $ver = [string]$m.version
        $todo = @()
        if ($script:installed) {
            foreach ($f in $m.files.PSObject.Properties) {
                $rel = [string]$f.Name; $hash = [string]$f.Value
                if ($rel -notmatch '^game/[A-Za-z0-9_. -]+$') { continue }
                $local = Join-Path $script:gameDir ($rel.Substring(5))
                $need = $true
                if (Test-Path -LiteralPath $local) {
                    if ((Get-FileHash -LiteralPath $local -Algorithm SHA256).Hash -eq $hash) { $need = $false }
                }
                if ($need) { $todo += ,@($rel, $hash, $local) }
            }
        }
        $selfNew = $false
        $bat = $env:ZYRO_BAT
        if ($m.launcher -and $bat -and (Test-Path -LiteralPath $bat)) {
            if ((Get-FileHash -LiteralPath $bat -Algorithm SHA256).Hash -ne [string]$m.launcher) { $selfNew = $true; $todo += ,@('launcher.bat', [string]$m.launcher, ($bat + '.new')) }
        }
        if ($todo.Count -eq 0) { SetUpd ('Up to date (version ' + (GetVersion) + ').'); return }
        $i = 0
        foreach ($it in $todo) {
            $i++
            SetUpd ('Downloading ' + $i + ' of ' + $todo.Count + '...')
            $url = $base + '/' + ((($it[0] -split '/') | ForEach-Object { [Uri]::EscapeDataString($_) }) -join '/') + $bust
            $tmp = $it[2] + '.tmp'
            $made += $tmp
            Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $tmp -TimeoutSec 180
            if ((Get-FileHash -LiteralPath $tmp -Algorithm SHA256).Hash -ne $it[1]) { throw ('Bad download: ' + $it[0]) }
        }
        foreach ($it in $todo) { Move-Item -LiteralPath ($it[2] + '.tmp') -Destination $it[2] -Force }
        if ($ver) { if (-not (Test-Path -LiteralPath $script:cfgDir)) { New-Item -ItemType Directory -Path $script:cfgDir -Force | Out-Null }; Set-Content -LiteralPath $script:verFile -Value $ver }
        if ($selfNew) {
            SetUpd 'Updated! Restarting...'
            $c = 'ping -n 3 127.0.0.1 >nul & move /y "' + $bat + '.new" "' + $bat + '" >nul & start "" "' + $bat + '"'
            Start-Process -FilePath 'cmd.exe' -ArgumentList ('/c ' + $c) -WindowStyle Hidden
            $form.Close()
        } else { SetUpd ('Updated to version ' + (GetVersion) + '.') }
    } catch {
        foreach ($t in $made) { Remove-Item -LiteralPath $t -Force -ErrorAction SilentlyContinue }
        $e = $_.Exception.Message; if ($e.Length -gt 60) { $e = $e.Substring(0, 60) }
        SetUpd ('Update failed: ' + $e)
    }
}

