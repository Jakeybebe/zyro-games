        # desktop shortcut
        $g.DrawString('Desktop shortcut', $fHead, [System.Drawing.Brushes]::White, 106, 328)
        $g.DrawString('Put a Zyro games icon on your desktop.', $fSub, $muted, 106, 356)
        $shov = ($script:hover -eq 'shortcutbtn')
        if ($shov) { $sbb = New-Object System.Drawing.SolidBrush (C 255 30 130 255) }
        else { $sbb = New-Object System.Drawing.SolidBrush (C 255 0 100 230) }
        $sbp = RR 106 384 200 40 8
        $g.FillPath($sbb, $sbp)
        $sbb.Dispose(); $sbp.Dispose()
        $sbf = New-Object System.Drawing.StringFormat
        $sbf.Alignment = 'Center'; $sbf.LineAlignment = 'Center'
        $g.DrawString('CREATE SHORTCUT', $fCard, [System.Drawing.Brushes]::White, (New-Object System.Drawing.RectangleF(106, 384, 200, 40)), $sbf)
        $sbf.Dispose()
        if (($script:shortcutMsg -ne '') -and ($script:t -lt $script:shortcutMsgUntil)) {
            $g.DrawString($script:shortcutMsg, $fSmall, $muted, 106, 434)
        }

        # updates
        $g.DrawString('Updates', $fHead, [System.Drawing.Brushes]::White, 106, 470)
        $g.DrawString(('Version ' + (GetVersion) + ' - get the latest game and launcher.'), $fSub, $muted, 106, 498)
        if ($script:hover -eq 'updatebtn') { $ubb = New-Object System.Drawing.SolidBrush (C 255 95 215 120) }
        else { $ubb = New-Object System.Drawing.SolidBrush (C 255 60 190 100) }
        $ubp = RR 106 526 200 40 8
        $g.FillPath($ubb, $ubp)
        $ubb.Dispose(); $ubp.Dispose()
        $ubf = New-Object System.Drawing.StringFormat
        $ubf.Alignment = 'Center'; $ubf.LineAlignment = 'Center'
        $dk = New-Object System.Drawing.SolidBrush (C 255 8 40 20)
        $g.DrawString('UPDATE', $fCard, $dk, (New-Object System.Drawing.RectangleF(106, 526, 200, 40)), $ubf)
        $dk.Dispose(); $ubf.Dispose()
        if (($script:updMsg -ne '') -and ($script:t -lt $script:updMsgUntil)) {
            $g.DrawString($script:updMsg, $fSmall, $muted, 106, 576)
        }
        $muted.Dispose()
    }
})

$form.Add_MouseMove({
    if ($script:dragging) {
        $form.Location = New-Object System.Drawing.Point(($form.Left + $_.X - $script:dragStart.X), ($form.Top + $_.Y - $script:dragStart.Y))
        return
    }
    $h = Hit $_.X $_.Y
    if ($h -ne $script:hover) {
        $script:hover = $h
        if ($h -ne '') { $form.Cursor = [System.Windows.Forms.Cursors]::Hand }
        else { $form.Cursor = [System.Windows.Forms.Cursors]::Default }
        $form.Invalidate()
    }
})

$form.Add_MouseLeave({
    if ($script:hover -ne '') {
        $script:hover = ''
        $form.Cursor = [System.Windows.Forms.Cursors]::Default
        $form.Invalidate()
    }
})

$form.Add_MouseDown({
    if ($_.Button -ne 'Left') { return }
    if ((Hit $_.X $_.Y) -eq '' -and $_.Y -lt 34 -and $_.X -lt 696) {
        $script:dragging = $true
        $script:dragStart = $_.Location
    }
})

$form.Add_MouseUp({
    $script:dragging = $false
    if ($_.Button -ne 'Left') { return }
    $h = Hit $_.X $_.Y
    if ($h -eq 'home' -or $h -eq 'library' -or $h -eq 'settings') {
        $script:page = $h
        $form.Invalidate()
    }
    elseif ($h -eq 'gamebtn') {
        if ($script:installed) { PlayGame } else { $script:dl = 0.0 }
        $form.Invalidate()
    }
    elseif ($h -eq 'shortcutbtn') {
        if (MakeShortcut) { $script:shortcutMsg = 'Shortcut added to your desktop.' }
        else { $script:shortcutMsg = 'Could not create the shortcut.' }
        $script:shortcutMsgUntil = $script:t + 4.0
        $form.Invalidate()
    }
    elseif ($h -eq 'updatebtn') { DoUpdate }
    elseif ($h -eq 'themeblue') { $script:theme = 'blue'; SaveTheme; $form.Invalidate() }
    elseif ($h -eq 'themeblack') { $script:theme = 'black'; SaveTheme; $form.Invalidate() }
    elseif ($h -eq 'close') { $form.Close() }
    elseif ($h -eq 'min') { $form.WindowState = 'Minimized' }
})

[void]$form.ShowDialog()
