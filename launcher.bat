            $selected = ($script:theme -eq $key)
            $hov = ($script:hover -eq ('theme' + $key))

            $cardBr = New-Object System.Drawing.SolidBrush (C 150 8 14 50)
            $cpath = RR $cx $cy 200 140 10
            $g.FillPath($cardBr, $cpath)
            if ($selected) { $bp = New-Object System.Drawing.Pen([System.Drawing.Color]::White, 2.5) }
            elseif ($hov) { $bp = New-Object System.Drawing.Pen((C 200 255 255 255), 1.5) }
            else { $bp = New-Object System.Drawing.Pen((C 70 255 255 255), 1) }
            $g.DrawPath($bp, $cpath)
            $bp.Dispose(); $cardBr.Dispose(); $cpath.Dispose()

            # preview swatch
            $sr = New-Object System.Drawing.Rectangle(($cx + 10), ($cy + 10), 180, 70)
            if ($key -eq 'black') {
                $pb = New-Object System.Drawing.Drawing2D.LinearGradientBrush($sr, (C 255 2 2 10), (C 255 30 16 70), 135.0)
            } else {
