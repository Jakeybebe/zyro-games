    # settings: theme picker
    if ($script:page -eq 'settings') {
        $muted = New-Object System.Drawing.SolidBrush (C 255 190 205 240)
        $g.DrawString('Theme', $fHead, [System.Drawing.Brushes]::White, 106, 98)
