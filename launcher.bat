            $g.DrawString($cd[3], $fSmall, $muted, ($cx + 13), ($cy + 114))

            # selected check
            if ($selected) {
                $ck = New-Object System.Drawing.SolidBrush ([System.Drawing.Color]::White)
                $g.FillEllipse($ck, ($cx + 164), ($cy + 16), 18, 18)
                $ck.Dispose()
                $cp2 = New-Object System.Drawing.Pen((C 255 20 60 170), 2)
                $cp2.StartCap = 'Round'; $cp2.EndCap = 'Round'
                $g.DrawLines($cp2, [System.Drawing.PointF[]]@((Pt ($cx + 169) ($cy + 25)), (Pt ($cx + 172) ($cy + 28)), (Pt ($cx + 178) ($cy + 21))))
                $cp2.Dispose()
            }
