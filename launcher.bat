            }
            $spath = RR ($cx + 10) ($cy + 10) 180 70 6
            $g.FillPath($pb, $spath)
            $pb.Dispose(); $spath.Dispose()
            $dot = New-Object System.Drawing.SolidBrush (C 200 255 255 255)
