$script:gameJs = @'
// --- INITIAL SETUP & FAVICON ---
function createFavicon(color = '#00FFCC') {
    const favCanvas = document.createElement('canvas');
    favCanvas.width = 32; favCanvas.height = 32;
    const fctx = favCanvas.getContext('2d');
    fctx.fillStyle = color;
    fctx.beginPath(); fctx.roundRect(0, 0, 32, 32, 6); fctx.fill();
    fctx.fillStyle = '#000'; fctx.font = 'bold 18px Arial';
    fctx.textAlign = 'center'; fctx.textBaseline = 'middle';
    fctx.fillText('JB', 16, 16);
    let link = document.querySelector("link[rel~='icon']");
    if (!link) {
        link = document.createElement('link');
        link.rel = 'icon';
        document.head.appendChild(link);
    }
    link.href = favCanvas.toDataURL();
}

// --- GLOBAL VARIABLES ---
let playerColor = '#00FFCC';
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const progressFill = document.getElementById('progress-fill');
const progressText = document.getElementById('progress-text') || document.getElementById('percentage-text'); 
const levelText = document.getElementById('level-indicator');
const menuLayer = document.getElementById('menu-layer');
const hardModeBtn = document.getElementById('hard-mode-btn');

const bgMusic = new Audio('music.mp3');
const warpSound = new Audio('https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3');
const explosionSound = new Audio('https://assets.mixkit.co/active_storage/sfx/1697/1697-preview.mp3');
bgMusic.loop = true;

let width, height, groundY;
let gameActive = false, gameWon = false, isTransitioning = false, musicStarted = false;
let currentLevel = 1, deaths = 0, isHardMode = false;

// UPDATED: Increased max levels to 10
const maxLevels = 10, levelLength = 10000;
let gameSpeed = 0, gameMode = 'cube', isGravityFlipped = false, distanceTraveled = 0;

// UPDATED: Extended level names array to accommodate 10 levels
const levelNames = [
    "Neon Plains", "Gravity Grove", "Wave Wasteland", "Inferno Vault", "Abyssal Core",
    "Electro Dynamic", "Matrix Madness", "Quantum Leap", "Sonic Wavefront", "Supernova Blast"
];

let obstacles = [], specialPortals = [], hazards = [], trail = [];
let shakeIntensity = 0, flashAlpha = 0;

// PHYSICS
const gravity = 1.1; 
const jumpForce = 18; 

const player = { x: 150, y: 0, w: 50, h: 50, dy: 0, jumped: false, rotation: 0, scale: 1 };
const portal = { x: -1000, y: 0, w: 80, h: 160, active: false };

// --- INPUT & RESIZE ---

window.setSkin = (color) => {
    playerColor = color;
    if (progressFill) progressFill.style.background = color;
};

if (hardModeBtn) {
    hardModeBtn.onclick = () => {
        isHardMode = !isHardMode;
        hardModeBtn.innerText = isHardMode ? "Hard Mode: ON" : "Hard Mode: OFF";
        hardModeBtn.style.color = isHardMode ? "#FF3366" : "white";
        hardModeBtn.style.borderColor = isHardMode ? "#FF3366" : playerColor;
    };
}

function resize() {
    width = window.innerWidth; height = window.innerHeight;
    canvas.width = width; canvas.height = height;
    groundY = height * 0.75;
    if (!gameActive) player.y = groundY - player.h;
}
window.addEventListener('resize', resize);
resize();

window.addEventListener('keydown', (e) => {
    if (e.code === 'Space') {
        if (gameWon) { location.reload(); return; }
        if (!gameActive && musicStarted && !isTransitioning) { resetLevel(); return; }
        if (!musicStarted) { bgMusic.play().catch(()=>{}); musicStarted = true; }
        
        if (!gameActive && !isTransitioning) {
            gameActive = true;
            if (menuLayer) menuLayer.style.display = 'none';
            gameSpeed = isHardMode ? 21 : 16;
            spawnObstacle();
        } else if (gameActive && !isTransitioning) {
            if (gameMode === 'cube' && !player.jumped) {
                player.dy = isGravityFlipped ? jumpForce : -jumpForce;
                player.jumped = true;
            } else if (gameMode === 'wave') {
                player.dy = isGravityFlipped ? 11 : -11;
            }
        }
    }
});

// --- CORE LOGIC ---

function resetLevel() {
    distanceTraveled = 0; obstacles = []; specialPortals = []; hazards = []; trail = [];
    isGravityFlipped = false; gameMode = 'cube';
    player.y = groundY - player.h; player.dy = 0; player.jumped = false; player.rotation = 0;
    portal.active = false; portal.x = -1000;
    gameActive = true; 
    gameSpeed = isHardMode ? (21 + (currentLevel * 1.5)) : (16 + (currentLevel * 1.5));
    bgMusic.currentTime = 0;
    bgMusic.play().catch(()=>{});
    spawnObstacle();
}

function spawnObstacle() {
    if (!gameActive || isTransitioning || distanceTraveled >= (levelLength - 2000)) return;
    
    // UPDATED: Drastically lowered skip chance so obstacles generate much more frequently
    let skipChance = isHardMode ? 0.15 : 0.25;
    
    if (Math.random() > skipChance) {
        if (Math.random() > 0.85 && currentLevel >= 2) {
            specialPortals.push({ x: width + 300, y: isGravityFlipped ? 0 : groundY - 180, w: 40, h: 120, type: Math.random() > 0.5 ? 'gravity' : 'wave' });
        } else {
            const type = Math.random() > 0.5 ? 'block' : 'spike';
            obstacles.push({ x: width + 300, y: type === 'block' ? (isGravityFlipped ? 0 : groundY - 110) : (isGravityFlipped ? 0 : groundY - 50), w: 50, h: type === 'block' ? 110 : 50, type: type });
        }
    }

    // UPDATED: Shortened delay time between spawns to make obstacles pack closer together
    let spawnRate = isHardMode ? 500 : 750; 
    setTimeout(spawnObstacle, spawnRate + Math.random() * 600);
}

function update() {
    if (shakeIntensity > 0) shakeIntensity *= 0.9;
    if (flashAlpha > 0) flashAlpha -= 0.05;

    if (isTransitioning) {
        player.scale *= 0.92; player.rotation += 25;
        player.x += (portal.x + 40 - player.x) * 0.15;
        player.y += (portal.y + 80 - player.y) * 0.15;
        portal.x -= gameSpeed;
        return;
    }

    if (!gameActive) return;

    distanceTraveled += gameSpeed;
    
    let percentage = Math.min(Math.floor((distanceTraveled / levelLength) * 100), 100);
    if (progressFill) progressFill.style.width = percentage + "%";
    if (progressText) progressText.innerText = percentage + "%";
    
    trail.push({ x: player.x, y: player.y, rotation: player.rotation });
    if (trail.length > 8) trail.shift();

    player.dy += isGravityFlipped ? -gravity : gravity;
    player.y += player.dy;

    if (player.y + player.h >= groundY) { 
        player.y = groundY - player.h; player.dy = 0; player.jumped = false; player.rotation = 0; 
    } else if (player.y <= 0) { 
        player.y = 0; player.dy = 0; player.jumped = false; player.rotation = 0;
    } else { 
        player.rotation += (gameSpeed * 0.7); 
    }

    hazards.forEach(h => h.x -= gameSpeed);
    
    obstacles.forEach(obs => {
        obs.x -= gameSpeed;
        let padding = obs.type === 'spike' ? 10 : 4; 
        if (player.x + padding < obs.x + obs.w - padding && player.x + player.w - padding > obs.x + padding && 
            player.y + padding < obs.y + obs.h - padding && player.y + player.h - padding > obs.y + padding) {
            
            let onTop = (!isGravityFlipped && player.dy >= 0 && player.y + player.h < obs.y + 35);
            let onBottom = (isGravityFlipped && player.dy <= 0 && player.y > obs.y + obs.h - 35);
            
            if (obs.type === 'block' && (onTop || onBottom)) {
                player.y = isGravityFlipped ? obs.y + obs.h : obs.y - player.h;
                player.dy = 0; player.jumped = false; player.rotation = 0;
            } else { die(); }
        }
    });

    specialPortals.forEach((p, i) => {
        p.x -= gameSpeed;
        if (player.x < p.x + p.w && player.x + player.w > p.x && player.y < p.y + p.h && player.y + player.h > p.y) {
            if (p.type === 'gravity') isGravityFlipped = !isGravityFlipped;
            else gameMode = (gameMode === 'cube' ? 'wave' : 'cube');
            specialPortals.splice(i, 1); flashAlpha = 0.5; warpSound.play();
        }
    });

    if (distanceTraveled >= levelLength && !portal.active) {
        portal.active = true; portal.x = width + 500; portal.y = isGravityFlipped ? 0 : groundY - 160;
    }
    if (portal.active) {
        portal.x -= gameSpeed;
        if (player.x < portal.x + 80 && player.x + 50 > portal.x && player.y < portal.y + 160 && player.y + 50 > portal.y) winLevel();
    }
}

function die() { gameActive = false; deaths++; bgMusic.pause(); bgMusic.currentTime = 0; explosionSound.play(); shakeIntensity = 15; }

function winLevel() {
    if (isTransitioning) return;
    warpSound.play(); flashAlpha = 1.0; gameActive = false; isTransitioning = true;
    setTimeout(() => {
        if (currentLevel >= maxLevels) { gameWon = true; isTransitioning = false; }
        else {
            currentLevel++; distanceTraveled = 0; obstacles = []; hazards = []; specialPortals = [];
            isGravityFlipped = false; gameMode = 'cube'; player.scale = 1; player.x = 150;
            portal.active = false; portal.x = -1000;
            levelText.innerText = `Level ${currentLevel}: ${levelNames[currentLevel-1]}`;
            gameSpeed = isHardMode ? (21 + (currentLevel * 1.5)) : (16 + (currentLevel * 1.5));
            isTransitioning = false; gameActive = true; spawnObstacle();
        }
    }, 1500);
}

function draw() {
    if (gameWon) {
        ctx.fillStyle = "#000"; ctx.fillRect(0, 0, width, height);
        ctx.fillStyle = "gold"; ctx.textAlign = "center"; ctx.font = "bold 60px Arial";
        ctx.fillText("GRAND CHAMPION", width/2, height/2 - 20);
        ctx.fillStyle = "white"; ctx.font = "24px Arial";
        ctx.fillText(`Total Deaths: ${deaths}`, width/2, height/2 + 40);
        ctx.fillText("Press Space to Restart", width/2, height/2 + 80);
        return;
    }
    ctx.save();
    if (shakeIntensity > 0.5) ctx.translate((Math.random()-0.5)*shakeIntensity, (Math.random()-0.5)*shakeIntensity);
    ctx.fillStyle = `hsl(${(currentLevel * 36)}, 30%, 10%)`; // Dynamic level styling
    ctx.fillRect(0, 0, width, height);
    ctx.fillStyle = "#000"; ctx.fillRect(0, groundY, width, height - groundY);
    ctx.strokeStyle = playerColor; ctx.lineWidth = 3; ctx.strokeRect(0, groundY, width, 2);

    trail.forEach((t, i) => {
        ctx.save(); ctx.globalAlpha = i/10; ctx.translate(t.x+25, t.y+25); ctx.rotate(t.rotation*Math.PI/180);
        ctx.fillStyle = playerColor; ctx.fillRect(-25, -25, 50, 50); ctx.restore();
    });

    obstacles.forEach(obs => {
        ctx.fillStyle = obs.type === 'spike' ? "#FF3366" : "#FFCC00";
        if (obs.type === 'spike') {
            ctx.beginPath(); ctx.moveTo(obs.x, obs.y + (isGravityFlipped?0:obs.h));
            ctx.lineTo(obs.x+25, obs.y + (isGravityFlipped?obs.h:0));
            ctx.lineTo(obs.x+50, obs.y + (isGravityFlipped?0:obs.h)); ctx.fill();
        } else ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
    });

    if (portal.active) {
        ctx.fillStyle = "cyan"; ctx.beginPath(); ctx.ellipse(portal.x+40, portal.y+80, 40, 80, 0, 0, Math.PI*2); ctx.fill();
    }
    specialPortals.forEach(p => { ctx.fillStyle = p.type === 'gravity' ? "#0066FF" : "#FF00FF"; ctx.fillRect(p.x, p.y, p.w, p.h); });

    ctx.save(); ctx.translate(player.x+25, player.y+25); ctx.scale(player.scale, player.scale);
    ctx.rotate(player.rotation*Math.PI/180); ctx.fillStyle = playerColor; ctx.fillRect(-25,-25,50,50);
    ctx.strokeStyle = "white"; ctx.strokeRect(-25,-25,50,50); ctx.restore();

    if (!gameActive && musicStarted && !isTransitioning) {
        ctx.fillStyle = "rgba(0,0,0,0.8)"; ctx.fillRect(0,0,width,height);
        ctx.fillStyle = "white"; ctx.textAlign = "center"; ctx.font = "30px Arial";
        ctx.fillText(`CRASHED! Deaths: ${deaths}`, width/2, height/2);
        ctx.font = "20px Arial"; ctx.fillText("Press Space to Retry", width/2, height/2 + 40);
    }
    if (flashAlpha > 0) { ctx.fillStyle = `rgba(255,255,255,${flashAlpha})`; ctx.fillRect(0,0,width,height); }
    ctx.restore();
}

let lastTime = 0;
function gameLoop(timestamp) {
    const deltaTime = timestamp - lastTime;
    if (deltaTime >= (1000/60)) {
        update(); draw(); lastTime = timestamp - (deltaTime % (1000/60));
    }
    requestAnimationFrame(gameLoop);
}

document.title = 'Dash';
const DASH_LOGO = 'data:image/png;base64,';
(function () {
    document.querySelectorAll("link[rel~='icon']").forEach(l => l.remove());
    const link = document.createElement('link');
    link.rel = 'icon'; link.type = 'image/png'; link.href = DASH_LOGO;
    document.head.appendChild(link);
})();
requestAnimationFrame(gameLoop);
'@

$script:musicB64 = ''

function InstallGame {
    try {
        if (-not (Test-Path -LiteralPath $script:gameDir)) { New-Item -ItemType Directory -Path $script:gameDir -Force | Out-Null }
        $enc = New-Object System.Text.UTF8Encoding($false)
        [System.IO.File]::WriteAllText((Join-Path $script:gameDir 'index.html'), $script:gameHtml, $enc)
        [System.IO.File]::WriteAllText((Join-Path $script:gameDir 'script.js'), $script:gameJs, $enc)
        [System.IO.File]::WriteAllBytes((Join-Path $script:gameDir 'music.mp3'), [System.Convert]::FromBase64String($script:musicB64))
        Set-Content -LiteralPath $script:stampFile -Value $script:buildId
        $script:installed = $true
    } catch {
        $script:installed = $false
        $script:dlMsg = 'Download failed. Try again.'
        $script:dlMsgUntil = $script:t + 4.0
    }
}

function PlayGame {
    $idx = Join-Path $script:gameDir 'index.html'
    if (-not (Test-Path -LiteralPath $idx)) {
        $script:installed = $false
        return
    }
    $stamp = ''
    try { $stamp = (Get-Content -LiteralPath $script:stampFile -Raw -ErrorAction Stop).Trim() } catch {}
    if ($stamp -ne $script:buildId -or -not (Test-Path -LiteralPath (Join-Path $script:gameDir 'music.mp3'))) { InstallGame }  # only when this launcher is newer than the installed game
    try {
        # Open as its own app window (no browser tabs / address bar) using Edge or Chrome in app mode
        $uri = ([System.Uri]$idx).AbsoluteUri
        $prof = Join-Path $script:gameDir 'profile'
        $cands = @(
            (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'),
            (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe'),
            (Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe'),
            (Join-Path ${env:ProgramFiles(x86)} 'Google\Chrome\Application\chrome.exe'),
            (Join-Path $env:LOCALAPPDATA 'Google\Chrome\Application\chrome.exe')
        )
        $exe = $null
        foreach ($c in $cands) { if ($c -and (Test-Path -LiteralPath $c)) { $exe = $c; break } }
        if ($exe) {
            $a = '--app="' + $uri + '" --user-data-dir="' + $prof + '" --window-size=1280,720 --autoplay-policy=no-user-gesture-required --no-first-run --no-default-browser-check'
            Start-Process -FilePath $exe -ArgumentList $a
        } else {
            Start-Process -FilePath $idx
        }
    }
    catch {
        $script:dlMsg = 'Could not open the game.'
        $script:dlMsgUntil = $script:t + 4.0
    }
}

function RR($x, $y, $w, $h, $r) {
    $p = New-Object System.Drawing.Drawing2D.GraphicsPath
    $d = $r * 2
    $p.AddArc($x, $y, $d, $d, 180, 90)
    $p.AddArc($x + $w - $d, $y, $d, $d, 270, 90)
    $p.AddArc($x + $w - $d, $y + $h - $d, $d, $d, 0, 90)
    $p.AddArc($x, $y + $h - $d, $d, $d, 90, 90)
    $p.CloseFigure()
    return $p
}

function C($a, $r, $g, $b) { [System.Drawing.Color]::FromArgb($a, $r, $g, $b) }
function Pt($x, $y) { New-Object System.Drawing.PointF([single]$x, [single]$y) }

function Hit($x, $y) {
    if ($x -ge 698 -and $x -le 732 -and $y -ge 4 -and $y -le 30) { return 'min' }
    if ($x -ge 738 -and $x -le 772 -and $y -ge 4 -and $y -le 30) { return 'close' }
    if ($x -ge 9 -and $x -le 59) {
        if ($y -ge 75 -and $y -le 125) { return 'home' }
        if ($y -ge 135 -and $y -le 185) { return 'library' }
        if ($y -ge 610 -and $y -le 660) { return 'settings' }
    }
    if ($script:page -eq 'library' -and $script:dl -lt 0 -and $x -ge 116 -and $x -le 316 -and $y -ge 290 -and $y -le 330) { return 'gamebtn' }
    if ($script:page -eq 'settings' -and $x -ge 106 -and $x -le 306 -and $y -ge 384 -and $y -le 424) { return 'shortcutbtn' }
    if ($script:page -eq 'settings' -and $x -ge 106 -and $x -le 306 -and $y -ge 526 -and $y -le 566) { return 'updatebtn' }
    if ($script:page -eq 'settings' -and $y -ge 170 -and $y -le 310) {
        if ($x -ge 106 -and $x -le 306) { return 'themeblue' }
        if ($x -ge 326 -and $x -le 526) { return 'themeblack' }
    }
    return ''
}

function Glow($gr, $cx, $cy, $rx, $ry, $a, $r, $gc, $b) {
    $path = New-Object System.Drawing.Drawing2D.GraphicsPath
    $path.AddEllipse([single]($cx - $rx), [single]($cy - $ry), [single](2 * $rx), [single](2 * $ry))
    $pgb = New-Object System.Drawing.Drawing2D.PathGradientBrush($path)
    $pgb.CenterColor = C $a $r $gc $b
    $pgb.SurroundColors = @((C 0 $r $gc $b))
    $gr.FillPath($pgb, $path)
    $pgb.Dispose(); $path.Dispose()
}

function Planet($gr, $cx, $cy, $r, $c1, $c2) {
    $path = New-Object System.Drawing.Drawing2D.GraphicsPath
    $path.AddEllipse([single]($cx - $r), [single]($cy - $r), [single](2 * $r), [single](2 * $r))
    $pgb = New-Object System.Drawing.Drawing2D.PathGradientBrush($path)
    $pgb.CenterPoint = New-Object System.Drawing.PointF([single]($cx - $r * 0.4), [single]($cy - $r * 0.4))
    $pgb.CenterColor = $c1
    $pgb.SurroundColors = @($c2)
    $gr.FillPath($pgb, $path)
    $pgb.Dispose(); $path.Dispose()
}

function RingedPlanet($gr, $cx, $cy, $r, $c1, $c2, $ringColor) {
    $rp = New-Object System.Drawing.Pen($ringColor, 3)
    $rx = [single](-$r * 1.9); $ry = [single](-$r * 0.55); $rw = [single]($r * 3.8); $rh = [single]($r * 1.1)
    $gr.TranslateTransform([single]$cx, [single]$cy)
    $gr.RotateTransform(-22)
    $gr.DrawEllipse($rp, $rx, $ry, $rw, $rh)
    $gr.ResetTransform()
    Planet $gr $cx $cy $r $c1 $c2
    $gr.TranslateTransform([single]$cx, [single]$cy)
    $gr.RotateTransform(-22)
    $gr.DrawArc($rp, $rx, $ry, $rw, $rh, 0, 180)
    $gr.ResetTransform()
    $rp.Dispose()
}

# --- stars ---
$rnd = New-Object System.Random 7
$script:stars = @()
for ($i = 0; $i -lt 110; $i++) {
    $script:stars += ,@($rnd.Next(76, 776), $rnd.Next(4, 676), (1.0 + $rnd.NextDouble() * 1.6), ($rnd.NextDouble() * 6.28))
}

$fTitle = New-Object System.Drawing.Font('Segoe UI', 24, [System.Drawing.FontStyle]::Bold)
$fHead  = New-Object System.Drawing.Font('Segoe UI', 13, [System.Drawing.FontStyle]::Bold)
$fSub   = New-Object System.Drawing.Font('Segoe UI', 10)
$fCard  = New-Object System.Drawing.Font('Segoe UI', 12, [System.Drawing.FontStyle]::Bold)
$fSmall = New-Object System.Drawing.Font('Segoe UI', 9)

$form = New-Object System.Windows.Forms.Form
$form.Text = 'Zyro games'
try { if (EnsureIcon) { $form.Icon = New-Object System.Drawing.Icon($script:iconFile) } } catch {}
$form.FormBorderStyle = 'None'
$form.ClientSize = New-Object System.Drawing.Size(780, 680)
$form.StartPosition = 'CenterScreen'
$form.BackColor = C 255 18 60 170
$form.GetType().GetProperty('DoubleBuffered', [Reflection.BindingFlags]'NonPublic,Instance').SetValue($form, $true, $null)
$form.Region = New-Object System.Drawing.Region (RR 0 0 780 680 12)

$timer = New-Object System.Windows.Forms.Timer
$timer.Interval = 100
$timer.Add_Tick({
    $script:t += 0.1
    if ($script:dl -ge 0) {
        $script:dl += 3.5
        if ($script:dl -ge 100) { $script:dl = -1.0; InstallGame }
    }
    $form.Invalidate()
})
$timer.Start()

$form.Add_Paint({
    $g = $_.Graphics
    $g.SmoothingMode = 'AntiAlias'
    $g.TextRenderingHint = 'AntiAliasGridFit'
    $W = 780; $H = 680
    $black = ($script:theme -eq 'black')

    # background gradient
    $rect = New-Object System.Drawing.Rectangle(0, 0, $W, $H)
    if ($black) {
        $bg = New-Object System.Drawing.Drawing2D.LinearGradientBrush($rect, (C 255 2 2 10), (C 255 18 10 44), 135.0)
    } else {
        $bg = New-Object System.Drawing.Drawing2D.LinearGradientBrush($rect, (C 255 5 20 140), (C 255 70 170 250), 135.0)
    }
    $g.FillRectangle($bg, $rect)
    $bg.Dispose()

    # nebula glows
    if ($black) {
        Glow $g 560 180 280 190 60 140 60 220
        Glow $g 200 520 260 170 50 40 90 220
        Glow $g 420 330 200 120 30 200 70 160
    } else {
        Glow $g 560 160 260 170 40 255 255 255
    }

    # twinkling stars
    $count = 110
    if (-not $black) { $count = 60 }
    $sbr = New-Object System.Drawing.SolidBrush ([System.Drawing.Color]::White)
    for ($i = 0; $i -lt $count; $i++) {
        $s = $script:stars[$i]
        $al = 125 + 100 * [Math]::Sin($script:t * 1.6 + $s[3])
        if (-not $black) { $al = $al * 0.65 }
        if ($al -lt 30) { $al = 30 }
        if ($al -gt 235) { $al = 235 }
        $sbr.Color = C ([int]$al) 255 255 255
        $g.FillEllipse($sbr, [single]$s[0], [single]$s[1], [single]$s[2], [single]$s[2])
    }
    $sbr.Dispose()

    # planets and moon
    if ($black) {
        Planet $g 690 650 125 (C 255 255 170 100) (C 255 90 25 70)
        RingedPlanet $g 625 135 26 (C 255 210 170 255) (C 255 70 45 150) (C 190 225 205 255)
        Planet $g 190 600 18 (C 255 238 238 245) (C 255 110 110 135)
    } else {
        Planet $g 690 650 125 (C 255 215 235 255) (C 255 35 100 205)
        RingedPlanet $g 625 135 26 (C 255 235 245 255) (C 255 70 130 225) (C 190 240 248 255)
        Planet $g 190 600 18 (C 255 245 248 255) (C 255 120 150 210)
    }
    # moon craters
    $cr = New-Object System.Drawing.SolidBrush (C 60 60 60 90)
    $g.FillEllipse($cr, 184, 596, 6, 6)
    $g.FillEllipse($cr, 194, 606, 4, 4)
    $g.FillEllipse($cr, 197, 593, 3, 3)
    $cr.Dispose()

    # sidebar + divider
    if ($black) { $sb = New-Object System.Drawing.SolidBrush (C 160 0 0 12) }
    else { $sb = New-Object System.Drawing.SolidBrush (C 120 12 50 130) }
    $g.FillRectangle($sb, 0, 0, 68, $H)
    $sb.Dispose()
    $dv = New-Object System.Drawing.Pen((C 45 255 255 255), 1)
    $g.DrawLine($dv, 68, 0, 68, $H)
    $dv.Dispose()

    # sidebar buttons: hover + active states
    $items = @(@('home', 75), @('library', 135), @('settings', 610))
    foreach ($it in $items) {
        $name = $it[0]; $top = $it[1]
        $isActive = ($script:page -eq $name)
        $isHover = ($script:hover -eq $name)
        if ($isActive -or $isHover) {
            $a = 25
            if ($isActive) { $a = 45 }
            $fb = New-Object System.Drawing.SolidBrush (C $a 255 255 255)
            $fp = RR 9 $top 50 50 10
            $g.FillPath($fb, $fp)
            $fb.Dispose(); $fp.Dispose()
        }
        if ($isActive) {
            if ($black) { $hp = New-Object System.Drawing.Pen((C 255 140 120 255), 3) }
            else { $hp = New-Object System.Drawing.Pen((C 255 10 10 20), 3) }
            $hpath = RR 9 $top 50 50 10
            $g.DrawPath($hp, $hpath)
            $hp.Dispose(); $hpath.Dispose()
        }
    }

    # sidebar icons
    $ip = New-Object System.Drawing.Pen((C 255 240 245 255), 1.8)
    $ip.LineJoin = 'Round'; $ip.StartCap = 'Round'; $ip.EndCap = 'Round'
    $g.DrawLines($ip, [System.Drawing.PointF[]]@((Pt 23 101), (Pt 34 91), (Pt 45 101)))
    $g.DrawRectangle($ip, 27, 101, 14, 11)
    $g.DrawLine($ip, 34, 112, 34, 106)
    $g.DrawLines($ip, [System.Drawing.PointF[]]@((Pt 23 170), (Pt 23 152), (Pt 31 152), (Pt 33 155), (Pt 45 155), (Pt 45 170), (Pt 23 170)))
    $g.DrawEllipse($ip, 30, 632, 8, 8)
    $g.DrawEllipse($ip, 27, 629, 14, 14)
    for ($i = 0; $i -lt 8; $i++) {
        $a = $i * [Math]::PI / 4
        $x1 = 34 + [Math]::Cos($a) * 7; $y1 = 636 + [Math]::Sin($a) * 7
        $x2 = 34 + [Math]::Cos($a) * 10; $y2 = 636 + [Math]::Sin($a) * 10
        $g.DrawLine($ip, [single]$x1, [single]$y1, [single]$x2, [single]$y2)
    }
    $ip.Dispose()

    # window buttons with hover
    if ($script:hover -eq 'min') {
        $mb = New-Object System.Drawing.SolidBrush (C 40 255 255 255)
        $mp = RR 698 4 34 26 6
        $g.FillPath($mb, $mp); $mb.Dispose(); $mp.Dispose()
    }
    if ($script:hover -eq 'close') {
        $cbr = New-Object System.Drawing.SolidBrush (C 220 220 50 60)
        $cp = RR 738 4 34 26 6
        $g.FillPath($cbr, $cp); $cbr.Dispose(); $cp.Dispose()
    }
    $wp = New-Object System.Drawing.Pen((C 255 240 245 255), 1.5)
    $g.DrawLine($wp, 710, 17, 720, 17)
    $g.DrawLine($wp, 750, 12, 760, 22)
    $g.DrawLine($wp, 760, 12, 750, 22)
    $wp.Dispose()

    # page title
    $title = 'Welcome to Zyro games!'
    if ($script:page -eq 'library') { $title = 'Library' }
    elseif ($script:page -eq 'settings') { $title = 'Settings' }
    $shadow = New-Object System.Drawing.SolidBrush (C 90 0 0 30)
    $g.DrawString($title, $fTitle, $shadow, 108, 38)
    $shadow.Dispose()
    $g.DrawString($title, $fTitle, [System.Drawing.Brushes]::White, 106, 36)

    # library: the "Test" game card
    if ($script:page -eq 'library') {
        $lmuted = New-Object System.Drawing.SolidBrush (C 255 190 205 240)

        $lcardBr = New-Object System.Drawing.SolidBrush (C 150 8 14 50)
        $lcard = RR 106 100 220 250 10
        $g.FillPath($lcardBr, $lcard)
        $lbp = New-Object System.Drawing.Pen((C 70 255 255 255), 1)
        $g.DrawPath($lbp, $lcard)
        $lbp.Dispose(); $lcardBr.Dispose(); $lcard.Dispose()

        # thumbnail
        $thumb = RR 116 110 200 110 8
        $g.SetClip($thumb)
        $trect = New-Object System.Drawing.Rectangle(116, 110, 200, 110)
        $tbg = New-Object System.Drawing.Drawing2D.LinearGradientBrush($trect, (C 255 44 33 24), (C 255 20 15 11), 90.0)
        $g.FillRectangle($tbg, $trect)
        $tbg.Dispose()
        $gb = New-Object System.Drawing.SolidBrush (C 255 0 0 0)
        $g.FillRectangle($gb, 116, 190, 200, 30)
        $gb.Dispose()
        $gl = New-Object System.Drawing.Pen((C 255 0 255 204), 2)
        $g.DrawLine($gl, 116, 190, 316, 190)
        $gl.Dispose()
        # cube
        $cubeB = New-Object System.Drawing.SolidBrush (C 255 0 255 204)
        $g.FillRectangle($cubeB, 140, 166, 24, 24)
        $cubeB.Dispose()
        $cubeP = New-Object System.Drawing.Pen([System.Drawing.Color]::White, 1.5)
        $g.DrawRectangle($cubeP, 140, 166, 24, 24)
        $cubeP.Dispose()
        # spike
        $spB = New-Object System.Drawing.SolidBrush (C 255 255 51 102)
        $g.FillPolygon($spB, [System.Drawing.PointF[]]@((Pt 216 190), (Pt 228 166), (Pt 240 190)))
        $spB.Dispose()
        # block
        $blB = New-Object System.Drawing.SolidBrush (C 255 255 204 0)
        $g.FillRectangle($blB, 270, 158, 26, 32)
        $blB.Dispose()
        $g.ResetClip()
        $thumb.Dispose()

        $g.DrawString('Test', $fCard, [System.Drawing.Brushes]::White, 114, 228)
        $g.DrawString('Dash through 10 levels', $fSmall, $lmuted, 115, 254)

        # button: Download / progress / Play
        $bhov = ($script:hover -eq 'gamebtn')
        $btnPath = RR 116 290 200 40 8
        $bf = New-Object System.Drawing.StringFormat
        $bf.Alignment = 'Center'; $bf.LineAlignment = 'Center'
        $btnRectF = New-Object System.Drawing.RectangleF(116, 290, 200, 40)
        if ($script:dl -ge 0) {
            $trk = New-Object System.Drawing.SolidBrush (C 60 255 255 255)
            $g.FillPath($trk, $btnPath); $trk.Dispose()
            $g.SetClip($btnPath)
            $pw = [single](200.0 * $script:dl / 100.0)
            $pf = New-Object System.Drawing.SolidBrush (C 255 0 100 230)
            $g.FillRectangle($pf, 116, 290, $pw, 40)
            $pf.Dispose()
            $g.ResetClip()
            $g.DrawString(('Downloading... ' + [int]$script:dl + '%'), $fCard, [System.Drawing.Brushes]::White, $btnRectF, $bf)
        } elseif ($script:installed) {
            if ($bhov) { $pb = New-Object System.Drawing.SolidBrush (C 255 95 215 120) }
            else { $pb = New-Object System.Drawing.SolidBrush (C 255 60 190 100) }
            $g.FillPath($pb, $btnPath); $pb.Dispose()
            $dark = New-Object System.Drawing.SolidBrush (C 255 8 40 20)
            $g.DrawString('PLAY', $fCard, $dark, $btnRectF, $bf)
